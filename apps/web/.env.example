# Server-side only. On Railway use the private domain:
#   http://${{cms.RAILWAY_PRIVATE_DOMAIN}}:1337
STRAPI_INTERNAL_URL=http://localhost:1337

# Public, browser-visible. Used for image URLs.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Read-only Strapi API token, scoped to homepage + site-settings.
STRAPI_API_TOKEN=

# Shared secret for POST /api/revalidate. Must match the Strapi webhook header.
REVALIDATE_SECRET=
