# Server
HOST=0.0.0.0
PORT=1337

# Secrets — generate real values, never commit them.
#   APP_KEYS: node -e "console.log([...Array(4)].map(()=>require('crypto').randomBytes(16).toString('base64')).join(','))"
#   others:   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Database
# Local dev runs Postgres in Docker (see README) so it matches Railway.
# On Railway set DATABASE_URL=${{Postgres.DATABASE_URL}} and drop the discrete
# DATABASE_HOST/PORT/NAME/USERNAME/PASSWORD vars — config/database.ts prefers
# the connection string when it is present.
DATABASE_CLIENT=postgres
DATABASE_URL=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=nota
DATABASE_USERNAME=nota
DATABASE_PASSWORD=nota
DATABASE_SSL=false
